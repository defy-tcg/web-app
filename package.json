{
  "name": "defy-tcg-inventory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:focused && npm run lint && npm run build",
    "test:focused": "node --test --experimental-strip-types tests/*.test.ts",
    "catalog:riftbound": "node --experimental-strip-types scripts/sync-riftbound-catalog.ts",
    "lint": "eslint . --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "qrcode-generator": "2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Defy TCG Inventory"
}
