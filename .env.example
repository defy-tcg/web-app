# Copy this file to .env.local, then use a development Neon branch.
# Production values remain in the existing defy-store-os Vercel project.
# Never commit .env.local or put these values in NEXT_PUBLIC_ variables.

# Pooled Neon Postgres connection string; keep SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require

# Neon Auth URL for the same development branch.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Generate a unique secret: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated approved store users. Set this explicitly per environment.
AUTHORIZED_EMAILS=you@example.com

# Singles intake uses Shopify as its stock authority. Development and Preview
# must use the separate development shop and location, never production stock.
SHOPIFY_SHOP_DOMAIN=defy-receiving-test.myshopify.com
SHOPIFY_CLIENT_ID=your-existing-defy-receiving-app-client-id
SHOPIFY_CLIENT_SECRET=your-server-only-app-client-secret
SHOPIFY_LOCATION_ID=gid://shopify/Location/your-development-location-id
# Publishing also requires the app's write_publications permission, with both
# Online Store and Point of Sale installed. Credentials are server-only.
