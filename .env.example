# Copy this file to .env.local, then use a development Neon branch.
# Production values remain in the existing defy-store-os Vercel project.
# Never commit .env.local or put these values in NEXT_PUBLIC_ variables.

# Pooled Neon Postgres connection string; keep SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require

# Neon Auth URL for the same development branch.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Generate a unique secret: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated approved store users. Set this explicitly per environment.
AUTHORIZED_EMAILS=you@example.com

# Scrydex card/sealed market prices. Only Riftbound singles sell at market x 1.06,
# rounded to the nearest cent. Other games and sealed products use market price.
# Both credentials are required and server-only.
SCRYDEX_API_KEY=your-scrydex-api-key
SCRYDEX_TEAM_ID=your-scrydex-team-id

# Singles intake uses Shopify as its stock authority. Development and Preview
# must use the separate development shop and location, never production stock.
SHOPIFY_SHOP_DOMAIN=defy-receiving-test.myshopify.com
SHOPIFY_CLIENT_ID=your-existing-defy-receiving-app-client-id
SHOPIFY_CLIENT_SECRET=your-server-only-app-client-secret
SHOPIFY_LOCATION_ID=gid://shopify/Location/your-development-location-id
# Publishing also requires write_publications and access to Online Store,
# Point of Sale, and the existing Defy website Headless publication.
# Credentials are server-only.
# The Defy Pricing POS extension must belong to this same app: its session
# tokens are verified using SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET.

# Shopify -> DefyOS synchronization. Enable only after applying the reviewed
# additive migration and registering app-signed webhooks at the deployed URL.
# Full sync also needs read_orders; only permitted order history is imported.
SHOPIFY_SYNC_ENABLED=false
# Defaults true. Set false to sync products/stock without order permissions.
# Existing saved orders and pending order jobs are retained while disabled.
SHOPIFY_SYNC_ORDERS_ENABLED=true
# Use the signing secret of the Shopify app that subscribes to the webhooks.
SHOPIFY_WEBHOOK_SECRET=your-existing-shopify-app-signing-secret
# Production application origin used to validate owner-triggered sync requests.
SHOPIFY_SYNC_ORIGIN=https://defy-store-os.vercel.app
# Vercel's authenticated daily retry job (reuse the existing production secret).
CRON_SECRET=your-private-cron-secret

# Existing Shopify POS product prices are refreshed from Scrydex daily.
# Production defaults enabled. Explicitly disable in development until ready.
# Uses the existing Shopify app's write_products permission and CRON_SECRET.
SHOPIFY_PRICE_SYNC_ENABLED=false
